{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlgebraLoveme/PIRA/claude/pira-routing-guard/evaluation/parity-summary.schema.json",
  "title": "PIRA paired parity result summary",
  "type": "object",
  "required": [
    "schema_version",
    "policy_commit",
    "plugin_version",
    "platform",
    "client_versions",
    "models",
    "client_config",
    "source_hashes",
    "worktree_dirty",
    "repetitions",
    "total",
    "passed",
    "by_client",
    "results"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "policy_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plugin_version": {"type": "string"},
    "platform": {"type": "object"},
    "client_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "models": {"type": "object"},
    "client_config": {
      "type": "object",
      "required": ["codex"],
      "properties": {
        "codex": {
          "type": "object",
          "required": [
            "external_skills_disabled",
            "disabled_skill_count",
            "disabled_skill_manifest_sha256"
          ],
          "properties": {
            "external_skills_disabled": {"const": true},
            "disabled_skill_count": {"type": "integer", "minimum": 0},
            "disabled_skill_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "source_hashes": {
      "type": "object",
      "required": ["matrix_sha256", "runner_sha256", "protocol_sha256"],
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "worktree_dirty": {"type": "boolean"},
    "repetitions": {"type": "integer", "minimum": 1},
    "total": {"type": "integer", "minimum": 1},
    "passed": {"type": "integer", "minimum": 0},
    "by_client": {"type": "object"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "client",
          "repetition",
          "id",
          "passed",
          "failures",
          "route_calls",
          "loaded_modules",
          "task_tools",
          "unexpected_skill_access_count",
          "duration_seconds",
          "usage",
          "artifact_dir",
          "artifact_hashes"
        ],
        "properties": {
          "client": {"enum": ["claude", "claude-policy-only", "codex"]},
          "repetition": {"type": "integer", "minimum": 1},
          "id": {"type": "string"},
          "passed": {"type": "boolean"},
          "failures": {"type": "array", "items": {"type": "string"}},
          "unexpected_skill_access_count": {"type": "integer", "minimum": 0},
          "artifact_dir": {"type": "string"},
          "artifact_hashes": {
            "type": "object",
            "required": ["events_jsonl_sha256", "stderr_txt_sha256"],
            "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
