589a669e6b14ee3382ec16495fe8ddb1"],["policy-only",2,"pm_mixed_new_task",1,"task",["explain"],["explain"],true,true,"ok",false,0,2,29455,12382,17069,200,5.441,"32421b329972698141713f37a17d8c091aaed1b7a816e8555ee4b3dd5e10e706"],["policy-only",2,"pm_mixed_new_task",2,"switch",["coding","research"],["coding","research"],true,true,"ok",false,0,3,46148,771,45371,309,6.277,"e7b08c21ef729cfd7ecce72beb0a04c612f7b197f58652bd205625ff9a5ca1c7"],["policy-only",2,"pm_zh_continuation_switch",1,"task",["research","writing"],["writing","research"],true,true,"ok",false,0,3,44955,12776,32173,412,10.306,"195d56d08f469ef3c03fba7e864d01cbb8b4e0dc1a6029b7e2d4f0f465d5393d"],["policy-only",2,"pm_zh_continuation_switch",2,"continuation",null,[],true,true,"ok",false,0,1,15502,642,14858,116,2.95,"c71b1190badd27a7bf9c7e74eb0175d3b88e87a09251c9e87e5f99ccc7c1d222"],["policy-only",2,"pm_zh_continuation_switch",3,"switch",["coding"],["coding"],true,true,"ok",false,0,3,48088,720,47362,335,7.19,"1677660602eff43e3498a5a9ca1456c06808a6208c4a9dd60745b6b7b9c78c80"],["policy-only",2,"pm_new_file_same_domain",1,"task",["coding","research"],["coding","research"],true,true,"ok",false,0,3,44755,12684,32065,304,7.078,"03a1b902cdcce330288e0c2c153fcd62c12fdc76e95a30f622be5c6153736664"],["policy-only",2,"pm_new_file_same_domain",2,"continuation",null,[],true,true,"ok",false,0,2,30893,762,30127,202,4.116,"31e21102ff73d8f28fdba38fbb8b8b9f25feecbbefe00c80f480d9b9176d3f82"]]}],"attachments":{"variant_f_hook_script":"\"\"\"Experiment F: per-turn reminder + automatic dependency injection + gate. No Skill.\n\n- SessionStart / UserPromptSubmit: inject a short routing reminder.\n- PreToolUse: until one PIRA module file has been read in this session, deny any tool other than a\n  Read of a module file.\n- PostToolUse (Read of a module file): record it, and inject the exact text of any canonical\n  dependency that is not loaded yet (coding/writing/paper_reading/public_figure -> research), so\n  dependency expansion is mechanical and costs no model turn.\nState per session (hash of session_id) under PIRA_ROUTING_STATE_DIR: loaded module names.\n\"\"\"\nimport hashlib\nimport json\nimport os\nimport sys\nfrom pathlib import Path\n\nMODULE_FILES = {\n    \"user_profile\": \"USER.md\", \"research\": \"modules/RESEARCH_POLICY.md\", \"paper_reading\": \"modules/PAPER_READING.md\",\n    \"coding\": \"modules/CODING_STYLE.md\", \"writing\": \"modules/SCIENTIFIC_WRITING.md\", \"public_figure\": \"modules/PUBLIC_FIGURE_STYLE.md\",\n    \"explain\": \"modules/EXPLAIN_STYLE.md\", \"guidance\": \"modules/GUIDANCE.md\", \"maintenance\": \"modules/MAINTENANCE.md\",\n}\nIMPLIED = {\"paper_reading\": [\"research\"], \"coding\": [\"research\"], \"writing\": [\"research\"], \"public_figure\": [\"research\"]}\nREMINDER = (\n    \"PIRA routing is pending. Before any other tool call or your answer, Read the exact PIRA module files the \"\n    \"project policy requires for this task. Reading a module automatically attaches its canonical dependency \"\n    \"(research), so do not read research separately. Do not re-read modules already loaded in this session. \"\n    \"Tools other than module Reads are blocked until a module has been read. If no module applies, answer \"\n    \"directly without tools.\"\n)\n\n\ndef state_path(session_id: str) -> Path:\n    root = Path(os.environ.get(\"PIRA_ROUTING_STATE_DIR\") or Path(os.environ.get(\"TEMP\", \"/tmp\")) / \"pira-autodep\")\n    return root / hashlib.sha256(session_id.encode(\"utf-8\")).hexdigest() / \"autodep.json\"\n\n\ndef load(path: Path) -> dict:\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return {\"loaded\": []}\n\n\ndef save(path: Path, state: dict) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(state), encoding=\"utf-8\")\n\n\ndef module_of(tool_input: dict) -> tuple[str | None, Path | None]:\n    file_path = str(tool_input.get(\"file_path\", \"\")).replace(\"\\\\\", \"/\")\n    for name, suffix in MODULE_FILES.items():\n        if file_path.endswith(suffix):\n            return name, Path(file_path[: -len(suffix)])\n    return None, None\n\n\ndef main() -> int:\n    data = json.load(sys.stdin)\n    event = data.get(\"hook_event_name\", \"\")\n    path = state_path(str(data.get(\"session_id\", \"\")) or \"unknown\")\n    state = load(path)\n    if event in (\"SessionStart\", \"UserPromptSubmit\"):\n        if event == \"SessionStart\":\n            save(path, {\"loaded\": []})\n        print(json.dumps({\"hookSpecificOutput\": {\"hookEventName\": event, \"additionalContext\": REMINDER}}))\n        return 0\n    tool_name = str(data.get(\"tool_name\", \"\"))\n    tool_input = data.get(\"tool_input\") if isinstance(data.get(\"tool_input\"), dict) else {}\n    if event == \"PreToolUse\":\n        if tool_name == \"Read\" and module_of(tool_input)[0]:\n            return 0\n        if state[\"loaded\"]:\n            return 0\n        print(json.dumps({\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\",\n                                                 \"permissionDecisionReason\": REMINDER}}))\n        return 0\n    if event == \"PostToolUse\" and tool_name == \"Read\":\n        module, root = module_of(tool_input)\n        if not module:\n            return 0\n        if module not in state[\"loaded\"]:\n            state[\"loaded\"].append(module)\n        sections = []\n        for dependency in IMPLIED.get(module, []):\n            if dependency in state[\"loaded\"]:\n                continue\n            dep_path = root / MODULE_FILES[dependency]\n            try:\n                content = dep_path.read_text(encoding=\"utf-8\")\n            except OSError:\n                continue\n            state[\"loaded\"].append(dependency)\n            sections.append(f\"### Loaded PIRA module: {dependency}\\n\\n{content.rstrip()}\\n\")\n        save(path, state)\n        if sections:\n            print(json.dumps({\"hookSpecificOutput\": {\"hookEventName\": \"PostToolUse\", \"additionalContext\":\n                              f\"PIRA: `{module}` requires the following canonical dependency, attached exactly; do not read it again.\\n\\n\" + \"\\n\".join(sections)}}))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}}
